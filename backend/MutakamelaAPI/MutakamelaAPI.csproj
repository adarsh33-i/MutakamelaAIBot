<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\products.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data\eval_queries.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Browser\Flows\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Rules\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
