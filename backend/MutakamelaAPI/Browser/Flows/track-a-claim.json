{
  "id": "track-a-claim",
  "title": "Track a claim",
  "title_ar": "تتبع مطالبة",
  "url": "https://eservices.mutakamela.sa/myInsurance/Track-a-Claim",
  "kind": "read-only",
  "requires_login": true,
  "requires_approval": false,
  "verified": false,
  "_note": "UNVERIFIED: selectors are placeholders until the live page is captured. The real browser agent refuses unverified specs; only the simulator runs them.",
  "screens": [
    {
      "id": "lookup",
      "title": "Claim lookup",
      "title_ar": "البحث عن المطالبة",
      "url_contains": "Track-a-Claim",
      "ready_selector": "role=heading",
      "fields": [
        {
          "id": "claim_number",
          "label": "Claim number",
          "label_ar": "رقم المطالبة",
          "type": "text",
          "required": true,
          "rule": "claim_number",
          "selectors": ["label=Claim Number", "label=رقم المطالبة", "input[name*='claim' i]"],
          "prompt": "What is your claim number?",
          "prompt_ar": "ما رقم المطالبة؟",
          "source": "customer"
        },
        {
          "id": "national_id",
          "label": "National ID / Iqama",
          "label_ar": "رقم الهوية / الإقامة",
          "type": "text",
          "required": true,
          "rule": "national_id",
          "selectors": ["label=National ID", "label=رقم الهوية", "input[name*='id' i]"],
          "prompt": "What is the National ID or Iqama number on the policy?",
          "prompt_ar": "ما رقم الهوية الوطنية أو الإقامة المسجل في الوثيقة؟",
          "source": "profile"
        }
      ],
      "next_selector": "role=button[name=/track|تتبع/i]",
      "error_selector": ".validation-message, .text-danger, [role=alert]"
    },
    {
      "id": "result",
      "title": "Claim status",
      "title_ar": "حالة المطالبة",
      "ready_selector": "text=/status|الحالة/i",
      "fields": []
    }
  ],
  "outputs": [
    { "id": "claim_status", "label": "Status", "label_ar": "الحالة", "selectors": ["[data-field='status']", "text=/status/i >> xpath=following-sibling::*[1]"] },
    { "id": "last_updated", "label": "Last updated", "label_ar": "آخر تحديث", "selectors": ["[data-field='updated']"] },
    { "id": "next_step", "label": "Next step", "label_ar": "الخطوة التالية", "selectors": ["[data-field='next-step']"] }
  ]
}
