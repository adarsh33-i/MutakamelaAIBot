{
  "manifest_version": 3,
  "name": "Mutakamela Portal Autofill",
  "version": "1.4.3",
  "description": "Opens Mutakamela's claim and complaint pages, fills supported fields, and transfers complaint documents locally.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://eservices.mutakamela.sa/*",
    "https://mutakamela.sa/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "chat-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://eservices.mutakamela.sa/*",
        "https://mutakamela.sa/submit-your-complaints/*",
        "https://mutakamela.sa/claim-center/*"
      ],
      "js": [
        "portal-autofill.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
