# Mutakamela AI Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Web chatbot
ADESSO_API_KEY=your-adesso-api-key
ADESSO_API_BASE=https://adesso-ai-hub.3asabc.de/v1
MODEL_NAME=gpt-4.1-mini
HOST=127.0.0.1
FLASK_DEBUG=false
CHAT_RATE_LIMIT=20 per minute
RATELIMIT_STORAGE_URI=memory://
# Optional comma-separated origins for a separate frontend; same-origin works without this.
CORS_ORIGINS=

# Or use Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
